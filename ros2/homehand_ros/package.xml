<?xml version="1.0"?>
<package format="3">
  <name>homehand_ros</name>
  <version>0.1.0</version>
  <description>ROS 2 interface of HomeHand (Unitree G1 + two Inspire hands in MuJoCo): simulation bridge,
    controller node (expert / residual RL / imitation policies) and Inspire RH56DFX command bridge.</description>
  <maintainer email="chutuanviet1302@users.noreply.github.com">chutuanviet1302</maintainer>
  <license>MIT</license>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>trajectory_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
